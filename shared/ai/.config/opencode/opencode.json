{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-pty",
    "@loreai/opencode",
    "@ex-machina/opencode-anthropic-auth@latest",
    "oh-my-opencode-slim",
    "opencode-acp@latest"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true,
  "model": "anthropic/claude-sonnet-5",
  "provider": {
    "local-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "local-ollama"
      },
      "models": {
        "qwen3:30b-a3b-thinking-2507-q4_K_M": {
          "name": "Qwen3 30B-A3B Thinking (local)"
        },
        "qwen3:4b-instruct-2507-q4_K_M": {
          "name": "Qwen3 4B Instruct (local, always-on)"
        }
      }
    }
  },
  "compaction": {
    "auto": false
  }
}
