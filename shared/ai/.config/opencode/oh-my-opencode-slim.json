{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "deepseek",
  "disabled_agents": [
    "designer",
    "council"
  ],
  "agents": {
    "skill-specialist": {
      "model": "anthropic/claude-sonnet-4-6",
      "variant": "low",
      "prompt": "You are a domain specialist who loads and applies project-specific skills.\n\nWhen called:\n1. The orchestrator will name a skill (e.g. '@skill-specialist rdkit compute molecular descriptors').\n2. Use the `skill` tool to load the named SKILL.md from .opencode/skills/.\n3. Apply the skill's instructions to the task.\n4. Return results concisely.\n\nSkills contain curated instructions, API references, and best practices. Trust them over your general knowledge.",
      "orchestratorPrompt": "@skill-specialist <skill-name>\n- Role: Domain specialist for a library/tool whose SKILL.md lives in .opencode/skills/\n- First loads the skill, then works on the task\n- **Delegate when:** Task requires deep domain knowledge available as a project skill (check .opencode/skills/ for available skills)\n- **Don't delegate:** General programming tasks, tasks where general knowledge suffices, or when the skill isn't symlinked in .opencode/skills/\n- Always specify the skill name, e.g., '@skill-specialist rdkit compute fingerprints for this dataset'\n- Skills active in this project are listed in AGENTS.md under 'Project Skills'"
    }
  },
  "presets": {
    "openai": {
      "orchestrator": {
        "model": "openai/gpt-5.5",
        "skills": [
          "*"
        ],
        "mcps": [
          "*",
          "!context7"
        ]
      },
      "oracle": {
        "model": "openai/gpt-5.5",
        "variant": "high",
        "skills": [
          "simplify"
        ],
        "mcps": []
      },
      "librarian": {
        "model": "openai/gpt-5.4-mini",
