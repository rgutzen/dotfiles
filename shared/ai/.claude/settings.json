{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/04_RESOURCES/Templates/Dippy/bin/dippy-hook"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "echo -n \"$(tput setab 0)$(tput setaf 15)  $(date +%H:%M) $(tput sgr0)\" && npx -y @owloops/claude-powerline@latest --theme=custom --style=powerline --config=~/.claude/powerline/claude-powerline.json"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-api@anthropic-agent-skills": true,
    "document-skills@anthropic-agent-skills": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "20minds@20minds": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "20minds": {
      "source": {
        "source": "github",
        "repo": "20minds/agent-plugins"
      }
    },
    "ruflo": {
      "source": {
        "source": "github",
        "repo": "ruvnet/ruflo"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
