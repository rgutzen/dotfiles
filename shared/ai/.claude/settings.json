{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:3207",
    "DISABLE_AUTO_COMPACT": "1",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f ~/.claude/dippy-hook.disabled ] && exit 0; ~/04_RESOURCES/Templates/Dippy/bin/dippy-hook"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Glob|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/06_SYSTEM/scripts/memory/pazras-guard",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/06_SYSTEM/scripts/memory/pazras-memory capture --harness=claude --event=skill-use"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/06_SYSTEM/scripts/memory/pazras-memory capture --harness=claude --event=session-end"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-api@anthropic-agent-skills": false,
    "document-skills@anthropic-agent-skills": false,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "20minds@20minds": false
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "20minds": {
      "source": {
        "source": "github",
        "repo": "20minds/agent-plugins"
      }
    },
    "ruflo": {
      "source": {
        "source": "github",
        "repo": "ruvnet/ruflo"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
