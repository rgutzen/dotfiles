# inbox-zero self-hosted .env template — reference only, NOT loaded directly.
#
# ~/.inbox-zero/.env is a real file with real secrets and is deliberately
# NOT tracked here (this repo is public). On a new machine:
#   1. cp ~/.inbox-zero/.env.example ~/.inbox-zero/.env
#   2. Generate fresh secrets for every *_SECRET/*_SALT/*_KEY below, e.g.:
#        openssl rand -hex 32
#   3. Re-register a Microsoft Entra ID app for this machine (client
#      secrets can't be moved between deployments) — see shared/inbox-zero/README.md.
#   4. Re-run `inbox-zero setup` if you'd rather redo it interactively; it
#      writes to this same file.

NEXT_PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL="postgresql://postgres:CHANGEME@db:5432/inboxzero"
DIRECT_URL="postgresql://postgres:CHANGEME@db:5432/inboxzero"
# Docker Compose credentials (defaults shown; POSTGRES_PASSWORD must match DATABASE_URL):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=inboxzero
# Optional Docker Compose host port overrides:
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6380
REDIS_HTTP_PORT=8079

UPSTASH_REDIS_URL="http://serverless-redis-http:80"
UPSTASH_REDIS_TOKEN=CHANGEME
REDIS_URL= # used for subscriptions and BullMQ worker: rediss://:password@host:port
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# bullmq needs REDIS_URL + the `worker` compose service (profile: queue-worker).
# qstash needs Upstash QStash credentials. internal needs neither — the web
# container processes jobs itself. Single-user self-host: internal is simplest.
QUEUE_BACKEND=internal # bullmq | qstash | internal

GOOGLE_CLIENT_ID=skipped
GOOGLE_CLIENT_SECRET=skipped
GOOGLE_PUBSUB_TOPIC_NAME=projects/your-project-id/topics/inbox-zero-emails
GOOGLE_PUBSUB_VERIFICATION_TOKEN=CHANGEME

# Requires an Entra ID app registration — see shared/inbox-zero/README.md.
# "Supported account types" must be "Accounts in any organizational directory
# ... and personal Microsoft accounts" to pair with the `common` tenant below;
# "Personal accounts only" mismatches and login fails.
MICROSOFT_CLIENT_ID=CHANGEME
# Copy the secret's Value column, not its Secret ID (both are GUID-shaped and
# easy to mix up; the ID is rejected with AADSTS7000215).
MICROSOFT_CLIENT_SECRET=CHANGEME
MICROSOFT_WEBHOOK_CLIENT_STATE=CHANGEME
MICROSOFT_TENANT_ID=common

# Slack (optional) — see docs/slack/setup.md
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# NEXT_PUBLIC_SLACK_BOT_NAME=Inbox Zero

# Chat SDK adapters (optional)
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
TEAMS_BOT_APP_TENANT_ID=
TELEGRAM_BOT_TOKEN=
# Required when Telegram webhooks are enabled. Used to verify x-telegram-bot-api-secret-token.
TELEGRAM_BOT_SECRET_TOKEN=

AUTH_SECRET=CHANGEME
# AUTH_ALLOWED_EMAILS=founder@gmail.com,admin@company.com # Optional self-hosted signup allowlist
# AUTH_ALLOWED_EMAIL_DOMAINS=company.com,subsidiary.org # Optional self-hosted signup domain allowlist
EMAIL_ENCRYPT_SECRET=CHANGEME
EMAIL_ENCRYPT_SALT=CHANGEME
INTERNAL_API_KEY=CHANGEME
API_KEY_SALT=CHANGEME
CRON_SECRET=CHANGEME

NEXT_PUBLIC_BYPASS_PREMIUM_CHECKS=true
# NEXT_PUBLIC_CONTACTS_ENABLED=true # Suggest Gmail and Outlook contacts while composing
# AUTO_JOIN_ORGANIZATION_ENABLED=true # Self-hosted: auto-add new users to the org
# SSO_LOGIN_ENABLED=true # Show and allow SSO login
# NEXT_PUBLIC_SELF_HOSTED_LOGIN_FOOTER_TEXT= # Self-hosted: override the login footer notice. Set to none to hide it.
# NEXT_PUBLIC_EXTERNAL_API_ENABLED=true # Enable the external API (v1 endpoints, API keys, API key UI)
# NEXT_PUBLIC_WEBHOOK_ACTION_ENABLED=false # Self-hosted: disable outgoing webhook rule actions and webhook secret UI
# NEXT_PUBLIC_DELETE_EMAIL_ACTION_ENABLED=true # Self-hosted: enable delete/trash rule actions
# NEXT_PUBLIC_INTEGRATION_ACTION_ENABLED=true # Enable integration rule actions globally (otherwise controlled by PostHog)
# MCP_SERVER_URL_OVERRIDES={"todoist":"http://localhost:4310/mcp"} # Point integrations at local MCP emulators (dev/test only)
# WEBHOOK_ALLOW_PRIVATE_IPS=true # Self-hosted: allow webhook delivery to private IPs (LAN, Tailscale 100.64.0.0/10). Only the webhook sender honors this flag; unsubscribe-link fetching and the Upstash client stay restricted. SECURITY: disables SSRF protection for webhook calls — only enable on a trusted, single-tenant deployment
# NEXT_PUBLIC_AI_MODEL_SETTINGS_DISABLED=true # Self-hosted: hide user AI model settings and enforce deployment-managed model settings
# AUTO_ENABLE_ORG_ANALYTICS=true # Self-hosted: default new org members to analytics enabled
# NEXT_PUBLIC_CONVERSION_ANALYTICS_SCRIPT_URL= # Optional: private conversion analytics script URL
# DISABLE_LOG_ZOD_ERRORS=true # Uncomment to disable Zod validation error logging
# DIGEST_MAX_SUMMARIES_PER_24H=50
# REASONING_RETENTION_DAYS=90 # Optional: redacts older AI reasoning fields after this many days
# DRAFT_SENT_TEXT_RETENTION_DAYS=14 # Redacts captured sent draft text after this many days
# WEBHOOK_URL=
# INTERNAL_API_URL= # Preferred callback base URL for QStash (when set) and server-side fallback calls

# =============================================================================
# LLM Configuration
# =============================================================================
#
# Local Ollama models, tier-split by reasoning need (see shared/ai/README.md
# for the model choice and install steps). The setup wizard only supports
# picking one model for every tier, so this split is applied by hand here:
#   DEFAULT / ECONOMY / NANO — high-volume per-email classification, low
#     reasoning effort — the small always-on model.
#   CHAT / DRAFT — lower-volume reply drafting and chat, medium reasoning
#     effort — the thinking model.
# (inbox-zero's own tier design: apps/web/utils/llms/model.ts,
# REASONING_EFFORT_BY_MODEL_TYPE.)

LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Deprecated legacy LLM env vars ---
# Still converted into the corresponding *_LLMS value at startup; the CLI
# setup wizard writes this format, not the newer DEFAULT_LLMS=provider:model
# one (see LLM provider blocks below for that alternative).
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# DEFAULT_LLM_FALLBACKS=openrouter:anthropic/claude-sonnet-4.6,openai:gpt-5.4-mini
ECONOMY_LLM_PROVIDER=ollama
ECONOMY_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# ECONOMY_LLM_FALLBACKS=openrouter:google/gemini-2.5-flash
CHAT_LLM_PROVIDER=ollama
CHAT_LLM_MODEL=qwen3:30b-a3b-thinking-2507-q4_K_M
# CHAT_LLM_FALLBACKS=openrouter:anthropic/claude-haiku-4.5
NANO_LLM_PROVIDER=ollama
NANO_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
DRAFT_LLM_PROVIDER=ollama
DRAFT_LLM_MODEL=qwen3:30b-a3b-thinking-2507-q4_K_M
# GOOGLE_THINKING_BUDGET=128 # Optional override for Gemini 2.x/2.5 thinking budget. Set to 0 to omit it. Gemini 3 still uses minimal thinking.

# Role model lists for other providers. Format: provider:model
# Add comma-separated entries to any row if you want ordered fallbacks.

# --- OpenRouter ---
# DEFAULT_LLMS=openrouter:anthropic/claude-sonnet-4.6
# ECONOMY_LLMS=openrouter:anthropic/claude-haiku-4.5
# CHAT_LLMS=openrouter:anthropic/claude-haiku-4.5
# NANO_LLMS=openrouter:anthropic/claude-haiku-4.5
# DRAFT_LLMS=openrouter:anthropic/claude-sonnet-4.6

# --- Anthropic ---
# DEFAULT_LLMS=anthropic:claude-sonnet-4-6
# ECONOMY_LLMS=anthropic:claude-haiku-4-5-20251001
# CHAT_LLMS=anthropic:claude-haiku-4-5-20251001
# NANO_LLMS=anthropic:claude-haiku-4-5-20251001
# DRAFT_LLMS=anthropic:claude-sonnet-4-6

# --- OpenAI ---
# DEFAULT_LLMS=openai:gpt-5.4-mini
# ECONOMY_LLMS=openai:gpt-5.4-nano
# CHAT_LLMS=openai:gpt-5.4-mini
# NANO_LLMS=openai:gpt-5.4-nano
# DRAFT_LLMS=openai:gpt-5.4-mini
# OPENAI_ZERO_DATA_RETENTION=

# --- OpenAI-Compatible (e.g. LM Studio, vLLM, LocalAI) ---
# DEFAULT_LLMS=openai-compatible:qwen3.5:4b
# ECONOMY_LLMS=openai-compatible:qwen3.5:4b
# CHAT_LLMS=openai-compatible:qwen3.5:4b
# NANO_LLMS=openai-compatible:qwen3.5:4b
# DRAFT_LLMS=openai-compatible:qwen3.5:4b
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPATIBLE_MODEL=qwen3.5:4b
# OPENAI_COMPATIBLE_AUTH_HEADER=authorization # authorization | api-key

# AI_NANO_WEEKLY_SPEND_LIMIT_USD=3
# AI_TRIAL_WEEKLY_SPEND_LIMIT_USD=2
# SENSITIVE_DATA_POLICY_DEFAULT=ALLOW # Default for accounts without a saved setting. Values: ALLOW, REDACT, BLOCK
# NEXT_PUBLIC_SENSITIVE_DATA_POLICY_LOCKED=false # Set true to enforce the default for all accounts, disable account-level edits, and hide the setting in the UI

# =============================================================================
# Everything below is optional — left blank/default, unused in this setup
# =============================================================================

TINYBIRD_TOKEN=
TINYBIRD_BASE_URL=https://api.us-east.tinybird.co/

SENTRY_AUTH_TOKEN=
SENTRY_ORGANIZATION=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=

AXIOM_DATASET=
AXIOM_TOKEN=
AXIOM_AUDIT_DATASET=
AXIOM_AUDIT_TOKEN=
NEXT_PUBLIC_AXIOM_DATASET=
NEXT_PUBLIC_AXIOM_TOKEN=

RESEND_API_KEY=
NEXT_PUBLIC_IS_RESEND_CONFIGURED=

LOOPS_API_SECRET=

# Meeting recorder (Recall.ai, third-party, off by default):
# RECALL_API_KEY=
# RECALL_WEBHOOK_SECRET=
# RECALL_REGION=us-west-2

# Feature flags
# NEXT_PUBLIC_DIGEST_ENABLED=true
# NEXT_PUBLIC_MEETING_BRIEFS_ENABLED=true
# NEXT_PUBLIC_MEETING_RECORDER_ENABLED=false # beta
# NEXT_PUBLIC_FOLLOW_UP_REMINDERS_ENABLED=true
# NEXT_PUBLIC_INTEGRATIONS_ENABLED=false # beta
# NEXT_PUBLIC_SMART_FILING_ENABLED=false # beta
# NEXT_PUBLIC_CLEANER_ENABLED=false # beta
# NEXT_PUBLIC_BOOKING_LINKS_ENABLED=false # beta
# NEXT_PUBLIC_AUTO_DRAFT_DISABLED=true # set to disable auto-drafting
