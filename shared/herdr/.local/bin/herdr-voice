#!/usr/bin/env bash
# herdr-voice — Voxtype post-process hook: spoken herdr commands, else dictation.
#
# Voxtype pipes the transcript to stdin and types whatever this prints. A
# transcript that opens with the word "herdr" — spelled as the recogniser heard
# it, within a small edit distance — and a known verb runs the herdr CLI and
# prints nothing, so nothing is typed. Everything else is echoed unchanged and
# typed at the cursor.
#
#   herdr new space <name>   herdr workspace create --label <name>
#   herdr pair <agent>       herdr-layout pair <agent>
#   herdr watch <view>       herdr-layout watch <view>
#   herdr layout <profile>   herdr-layout <profile> (edit|pair|git|watch)
#
# Session: $HERDR_VOICE_SESSION, else the first running of personal, work,
# default (the daemon has no herdr context of its own).
# HERDR_VOICE_DRY=1 prints the command to stderr instead of running it.

set -uo pipefail

herdr_bin=${HERDR_BIN_PATH:-herdr}
transcript=$(cat)

# Speech-to-text capitalises and punctuates: "Herdr, new space Dotfiles."
words=$(printf '%s' "$transcript" | tr '[:upper:]' '[:lower:]' | tr -d '[:punct:]')
read -r -a w <<<"$words"

passthrough() {
    printf '%s' "$transcript"
    exit 0
}

# The recogniser has no custom vocabulary here, so it writes the wake word as it
# hears it: "Herder", "hearder", "heard her". Match the leading word(s) by edit
# distance instead of demanding the spelling — and let the verb gate below do
# the rest of the filtering, so a stray near-match simply falls through.
lev() { # <a> <b> -> edit distance
    printf '%s\n%s\n' "$1" "$2" | awk '
        NR==1 { al=length($0); for (i=1;i<=al;i++) a[i]=substr($0,i,1) }
        NR==2 { bl=length($0); for (j=1;j<=bl;j++) b[j]=substr($0,j,1) }
        END {
            for (i=0;i<=al;i++) d[i,0]=i
            for (j=0;j<=bl;j++) d[0,j]=j
            for (i=1;i<=al;i++) for (j=1;j<=bl;j++) {
                cost = (a[i]==b[j]) ? 0 : 1
                m = d[i-1,j] + 1
                if (d[i,j-1] + 1 < m) m = d[i,j-1] + 1
                if (d[i-1,j-1] + cost < m) m = d[i-1,j-1] + cost
                d[i,j] = m
            }
            print d[al,bl]
        }'
}

# How many leading tokens spell the wake word: 1 normally, 2 when it was heard
# as two words ("heard her"). Tolerance grows with the candidate's length, and
# deliberately stays tight for short ones — "heard" alone is a real word, and a
# loose match there would eat the first token of an ordinary sentence.
offset=0
for n in 1 2; do
    cand=""
    for ((k = 0; k < n; k++)); do cand+=${w[k]:-}; done
    [[ -n $cand ]] || continue
    if ((n == 2)); then
        max=3
    elif ((${#cand} >= 6)); then
        max=2
    else
        max=1
    fi
    if (($(lev "$cand" herdr) <= max)); then
        offset=$n
        break
    fi
done
((offset)) || passthrough
v=("${w[@]:offset}")

session() {
    [[ -n ${HERDR_VOICE_SESSION:-} ]] && { echo "$HERDR_VOICE_SESSION"; return; }
    local running s
    running=$("$herdr_bin" session list 2>/dev/null | awk '$2=="running"{print $1}')
    for s in personal work default; do
        grep -qx "$s" <<<"$running" && { echo "$s"; return; }
    done
}

run() {
    local s
    s=$(session)
    [[ -n $s ]] && set -- "$herdr_bin" --session "$s" "${@:2}" || set -- "$herdr_bin" "${@:2}"
    if [[ -n ${HERDR_VOICE_DRY:-} ]]; then
        echo "herdr-voice: $*" >&2
        return 0
    fi
    "$@" >/dev/null 2>&1 || notify-send -a herdr-voice "herdr-voice" "failed: ${words}" 2>/dev/null
}

layout() { # <profile> [arg]
    local s wrapper
    s=$(session)
    if [[ -n ${HERDR_VOICE_DRY:-} ]]; then
        echo "herdr-voice: herdr-layout $* (session ${s:-none})" >&2
        return 0
    fi
    # herdr-layout calls $HERDR_BIN_PATH with no --session, so point it at a
    # one-line wrapper that adds the session.
    wrapper=${XDG_RUNTIME_DIR:-/tmp}/herdr-voice-bin
    mkdir -p "$wrapper"
    printf '#!/bin/sh\nexec %q%s "$@"\n' "$herdr_bin" "${s:+ --session $s}" >"$wrapper/herdr"
    chmod +x "$wrapper/herdr"
    HERDR_BIN_PATH=$wrapper/herdr herdr-layout "$@" >/dev/null 2>&1 ||
        notify-send -a herdr-voice "herdr-voice" "failed: ${words}" 2>/dev/null
}

case "${v[0]:-} ${v[1]:-}" in
"new space")
    name=${v[*]:2}
    [[ -n $name ]] || passthrough
    run herdr workspace create --label "${name// /-}"
    ;;
*)
    case ${v[0]:-} in
    pair) layout pair "${v[1]:-}" ;;
    watch)
        view=${v[1]:-}
        [[ $view == schedule ]] && view=sessions
        layout watch "$view"
        ;;
    layout)
        [[ -n ${v[1]:-} ]] || passthrough
        layout "${v[1]}"
        ;;
    *) passthrough ;;
    esac
    ;;
esac
exit 0
