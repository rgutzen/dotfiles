#!/usr/bin/env bash
# herdr-palette — one searchable list of every herdr action, instead of remembered keys.
#
# Opens as a popup on prefix+space. Each row: action, keybinding, voice phrase.
# Keybindings are read from config.toml.base ([keys] and [[keys.command]]), so a
# rebinding cannot leave the palette stale; only the action -> command table
# below is static.
#
# usage: herdr-palette             fzf list, Enter runs the action
#        herdr-palette --list      print the rows (no fzf)
#        herdr-palette --wanted    prompt for a friction note and log it
#        herdr-palette --friction  print the friction log
# Friction log: ~/.local/state/herdr/friction.log (one "<time> [<space>] wanted: <text>" per line).

set -euo pipefail

herdr_bin=${HERDR_BIN_PATH:-herdr}
base=${HERDR_PALETTE_BASE:-$HOME/.config/herdr/config.toml.base}
log=${HERDR_FRICTION_LOG:-$HOME/.local/state/herdr/friction.log}

# Static table: label | key source | voice phrase | command.
# key source: k:<[keys] name>, c:<[[keys.command]] command>, - for none.
# Commands that need input prompt on the tty; a leading '!' marks it interactive.
actions=(
"layout: edit tab|c:herdr-layout|herdr layout edit|herdr-layout edit"
"layout: pair (pi agent beside)|c:herdr-layout|herdr pair <agent>|herdr-layout pair"
"layout: git tab|c:herdr-layout|herdr layout git|herdr-layout git"
"layout: watch tab|c:herdr-layout|herdr watch <view>|herdr-layout watch todos"
"new space|k:new_workspace|herdr new space <name>|!new_space"
"worktree: create for a branch|-|-|!worktree"
"lazygit popup|c:lazygit|-|lazygit"
"watch: todos|c:herdr-watch todos|herdr watch todos|herdr-layout watch todos"
"watch: schedule sessions|-|herdr watch schedule|herdr-layout watch sessions"
"watch: relay|-|herdr watch relay|herdr-layout watch relay"
"watch: git|-|herdr watch git|herdr-layout watch git"
"agent: prompt|-|-|!agent_prompt"
"agent: read output|-|-|!agent_read"
"session: restart (personal or work)|-|-|!session_restart"
"reload config|k:reload_config|-|herdr server reload-config"
"help|k:help|-|!help"
"friction: log a wanted thing|c:herdr-palette --wanted|-|!wanted"
"friction: show log|-|-|!friction"
)

# "<name>\t<value>" for [keys], "cmd:<command>\t<key>" for [[keys.command]].
parse_base() {
    [[ -r $base ]] || return 0
    awk '
        function flush() { if (key != "") print "cmd:" cmd "\t" key; key = cmd = "" }
        /^\[\[keys\.command\]\]/ { flush(); sec = "cmd"; next }
        /^\[/ { flush(); sec = ($0 ~ /^\[keys\]/) ? "keys" : ""; next }
        /^[[:space:]]*#/ || !/=/ { next }
        {
            name = $0; sub(/[[:space:]]*=.*/, "", name); gsub(/[[:space:]]/, "", name)
            val = $0; sub(/^[^=]*=[[:space:]]*/, "", val); sub(/[[:space:]]+#.*$/, "", val)
            sub(/^\[/, "", val); sub(/\]$/, "", val); gsub(/"/, "", val); gsub(/,[[:space:]]*/, ", ", val)
            if (sec == "keys") print name "\t" val
            else if (sec == "cmd") { if (name == "key") key = val; else if (name == "command") cmd = val }
        }
        END { flush() }
    ' "$base"
}

rows() {
    local parsed a label src voice cmd key name val ref
    parsed=$(parse_base)
    for a in "${actions[@]}"; do
        IFS='|' read -r label src voice cmd <<<"$a"
        key=-
        case $src in
        k:*) key=$(awk -F'\t' -v n="${src#k:}" '$1==n{print $2; exit}' <<<"$parsed") ;;
        c:*)
            ref=${src#c:}
            key=$(awk -F'\t' -v c="cmd:$ref" '$1==c{print $2; exit}' <<<"$parsed")
            [[ -n $key ]] || key=$(awk -F'\t' -v c="cmd:$ref" 'index($1,c)==1{print $2; exit}' <<<"$parsed")
            ;;
        esac
        printf '%-34s\t%-26s\t%s\t%s\n' "$label" "${key:--}" "$voice" "$cmd"
    done
    # herdr's own bound keys, informational: the palette cannot press them.
    while IFS=$'\t' read -r name val; do
        [[ -n $name && $name != cmd:* ]] || continue
        printf '%-34s\t%-26s\t%s\t%s\n' "herdr: ${name//_/ }" "$val" "-" "!key"
    done <<<"$parsed"
}

current_space() {
    local ws
    ws=$("$herdr_bin" pane current 2>/dev/null | jq -r '.result.pane.workspace_id // empty') || true
    [[ -n $ws ]] || { echo "-"; return; }
    "$herdr_bin" workspace get "$ws" 2>/dev/null | jq -r '.result.workspace.label // empty' || echo "$ws"
}

ask() { # <prompt> -> stdout
    local v
    read -r -p "$1: " v </dev/tty >/dev/tty
    printf '%s' "$v"
}

wanted() {
    local text=${1:-}
    [[ -n $text ]] || text=$(ask "wanted")
    [[ -n $text ]] || return 0
    mkdir -p "$(dirname "$log")"
    printf '%s [%s] wanted: %s\n' "$(date '+%Y-%m-%d %H:%M')" "$(current_space)" "$text" >>"$log"
}

run_interactive() {
    local id=$1 a b
    case $id in
    new_space) a=$(ask "space name"); [[ -z $a ]] || "$herdr_bin" workspace create --label "${a// /-}" ;;
    worktree) a=$(ask "branch"); [[ -z $a ]] || "$herdr_bin" worktree create --branch "$a" ;;
    agent_prompt) a=$(ask "agent"); b=$(ask "prompt"); [[ -z $a || -z $b ]] || "$herdr_bin" agent prompt "$a" "$b" ;;
    agent_read) a=$(ask "agent"); [[ -z $a ]] || "$herdr_bin" agent read "$a" | ${PAGER:-less} ;;
    session_restart) a=$(ask "context (personal|work)"); [[ -z $a ]] || herdr-session "$a" --restart ;;
    help) "$herdr_bin" --help | ${PAGER:-less} ;;
    wanted) wanted ;;
    friction) friction | ${PAGER:-less} ;;
    key) echo "bound key only: press it in herdr." >/dev/tty; sleep 1 ;;
    esac
}

friction() {
    [[ -r $log ]] && cat "$log" || echo "(no friction logged)"
}

case ${1:-} in
--list) rows | cut -f1-3 | tr '\t' ' ' ; exit 0 ;;
--wanted) shift; wanted "$*"; exit 0 ;;
--friction) friction; exit 0 ;;
-h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

command -v fzf >/dev/null || { echo "herdr-palette: fzf not found" >&2; exit 1; }
pick=$(rows | fzf --delimiter=$'\t' --with-nth=1,2,3 --tabstop=4 --prompt='herdr> ' \
    --header='action  |  key  |  voice' --no-sort) || exit 0
cmd=${pick##*$'\t'}
if [[ $cmd == !* ]]; then
    run_interactive "${cmd#!}"
else
    # shellcheck disable=SC2086
    exec $cmd
fi
