#!/usr/bin/env bash
# herdr-layout — build one tab profile in the calling space.
#
# Profiles are built on demand, never as a template: a five-tab layout for a
# one-tab task is how a space becomes noise. Reachable from a herdr pane
# (prefix+alt+l) and from the CLI, so an agent can build the same shape.
#
# usage: herdr-layout [edit|pair|git|watch] [arg]
#   edit        a tab running nvim in the current directory
#   pair        split the calling pane, start pi in the right pane, keep focus
#   git         a tab running lazygit
#   watch       a tab running herdr-watch <view>

set -euo pipefail

herdr_bin=${HERDR_BIN_PATH:-herdr}
profile=${1:-edit}
arg=${2:-}

# Where a new tab or split starts. Called from inside a pane, $PWD IS that pane's
# directory and is the right answer. Called from a popup or from the voice hook
# there is no HERDR_PANE_ID at all, and $PWD is then the popup's or the voxtype
# daemon's — so ask herdr for the focused pane instead. Verified 2026-10-24: from
# ~ the pair split started its agent in /home/rg, not in the focused repo.
cur=""
if [[ -z ${HERDR_PANE_ID:-} ]]; then
    cur=$("$herdr_bin" pane current 2>/dev/null || true)
fi
focused_pane() { jq -r '.result.pane.pane_id // empty' <<<"$cur" 2>/dev/null; }
cwd=${HERDR_LAYOUT_CWD:-}
if [[ -z $cwd ]]; then
    if [[ -n ${HERDR_PANE_ID:-} ]]; then
        cwd=$PWD
    else
        cwd=$(jq -r '.result.pane.cwd // empty' <<<"$cur" 2>/dev/null || true)
        [[ -n $cwd ]] || cwd=$PWD
    fi
fi

die() {
    echo "herdr-layout: $*" >&2
    exit 1
}

new_tab() { # <label> <command...>
    local label=$1 pane
    shift
    pane=$("$herdr_bin" tab create --label "$label" --cwd "$cwd" --focus |
        jq -r '.result.root_pane.pane_id // empty')
    [[ -n $pane ]] || die "tab create returned no pane id"
    # The pty buffers this until the shell is ready, so no sleep is needed.
    "$herdr_bin" pane run "$pane" "$@" >/dev/null
}

case $profile in
edit)
    new_tab edit nvim
    ;;
pair)
    # Called from a popup or the voice hook there is no HERDR_PANE_ID: the
    # focused pane, resolved once above, is the one to split.
    target=${HERDR_PANE_ID:-$(focused_pane)}
    [[ -n $target ]] || die "no focused pane to split"
    agent_pane=$("$herdr_bin" pane split "$target" --direction right --ratio 0.4 \
        --cwd "$cwd" --no-focus | jq -r '.result.pane.pane_id // empty')
    [[ -n $agent_pane ]] || die "pane split returned no pane id"
    name=${arg:-pi-impl}
    "$herdr_bin" agent start "$name" --kind pi --pane "$agent_pane"
    # The name is the handle you address by, and herdr's sidebar shows the agent
    # KIND ("pi") until it is told otherwise — so report the name as the display
    # label. Without this the name exists only in `herdr agent list`.
    "$herdr_bin" pane report-metadata "$agent_pane" --source herdr-layout \
        --display-agent "$name" >/dev/null 2>&1 || true
    ;;
git)
    new_tab git lazygit
    ;;
watch)
    new_tab watch herdr-watch "${arg:-todos}"
    ;;
*)
    die "unknown profile '$profile' (edit|pair|git|watch)"
    ;;
esac
