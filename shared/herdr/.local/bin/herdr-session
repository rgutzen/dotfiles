#!/usr/bin/env bash
# herdr-session — open the herdr session for one context, with its own accent.
#
# One server per context (DESIGN D2). The accent is the only thing that differs
# between them, so the window you are looking at says which context it is.
# Accents are read from the active palette in config.toml's generated
# [theme.custom] block, so they follow a theme change instead of being hardcoded:
#   personal -> green      work -> accent
#
# usage: herdr-session personal|work [--restart]
#        herdr-session --generate [personal|work ...]   write the configs, do not start herdr
#   --restart   stop the context's server first, so a changed palette reaches it

set -euo pipefail

herdr_bin=${HERDR_BIN_PATH:-herdr}
cfg=$HOME/.config/herdr
base=$cfg/config.toml.base
generated=$cfg/config.toml
outdir=$cfg/sessions
contexts=(personal work)

die() {
    echo "herdr-session: $*" >&2
    exit 1
}

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

# Palette key whose colour becomes the accent of a context.
palette_key() {
    case $1 in
        personal) echo green ;;
        work) echo accent ;;
        *) die "unknown context '$1' (personal|work)" ;;
    esac
}

generate() { # <ctx>
    local ctx=$1 key color tmp
    key=$(palette_key "$ctx")
    [[ -r $base && -r $generated ]] || die "need $base and $generated (run the 20-herdr.sh theme hook)"
    color=$(sed -nE "/^\[theme\.custom\]/,\$ s/^$key[[:space:]]*=[[:space:]]*\"(#[0-9a-fA-F]{6})\".*/\1/p" "$generated" | head -n1)
    [[ -n $color ]] || die "no '$key' in the [theme.custom] block of $generated"

    mkdir -p "$outdir"
    tmp=$(mktemp "$outdir/$ctx.toml.XXXXXX")
    {
        cat "$base"
        printf '\n# --- generated by herdr-session for the %s context: accent = palette %s ---\n' "$ctx" "$key"
        # The theme block of config.toml, with this context's accent swapped in.
        sed -nE '/^\[theme\.custom\]/,$ p' "$generated" |
            sed -E "s/^accent([[:space:]]*)=.*/accent\1= \"$color\"/"
    } >"$tmp"
    if ! HERDR_CONFIG_PATH=$tmp "$herdr_bin" config check >/dev/null 2>&1; then
        HERDR_CONFIG_PATH=$tmp "$herdr_bin" config check 2>&1 | head -5 >&2 || true
        rm -f "$tmp"
        die "generated config for '$ctx' failed config check"
    fi
    mv "$tmp" "$outdir/$ctx.toml"
}

restart=0
generate_only=0
args=()
for a in "$@"; do
    case $a in
        -h|--help) usage; exit 0 ;;
        --restart) restart=1 ;;
        --generate) generate_only=1 ;;
        *) args+=("$a") ;;
    esac
done

if (( generate_only )); then
    for ctx in "${args[@]:-${contexts[@]}}"; do generate "$ctx"; done
    exit 0
fi

(( ${#args[@]} == 1 )) || { usage >&2; exit 2; }
ctx=${args[0]}
generate "$ctx"

if (( restart )); then
    HERDR_CONFIG_PATH=$outdir/$ctx.toml "$herdr_bin" --session "$ctx" server stop >/dev/null 2>&1 || true
    sleep 1
else
    # A running server keeps the config it started with; hand it the one just generated.
    HERDR_CONFIG_PATH=$outdir/$ctx.toml "$herdr_bin" --session "$ctx" server reload-config >/dev/null 2>&1 || true
fi

HERDR_CONFIG_PATH=$outdir/$ctx.toml exec "$herdr_bin" --session "$ctx"
