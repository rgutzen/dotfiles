#!/usr/bin/env python3
"""say -- speak text through the local voice-tts service, sentence by sentence.

WHY. One sentence is the unit that matters. The service needs ~0.5 s for the
first sentence and then runs several times faster than playback, so splitting
the text lets the voice start while the rest is still being synthesised. Feed it
an artifact and it reads the prose, skipping what cannot be spoken.

    say "Robin, the tests pass."
    cat note.md | say
    say --voice bm_george --speed 1.1 "Slower is not always clearer."
    say --out /tmp/reply.wav --no-play "Write to a file instead."

Text that is not speech is dropped on the way in: fenced code, tables, bare URLs
and markdown syntax. Pronunciation of paths and symbols is not attempted.

A failure prints its cause to stderr. A key binding has no terminal, so the bind
scripts pass `--notify`: each failure also becomes one desktop notification,
at most one per cause every 30 s, and a success stays quiet. The notification
ends with the doctor's line for that cause, so it says what to look at.

`say --doctor` checks the chain once, in order, one line each, and stops at the
first class that fails: service, token, sink, tools, watcher, config.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import queue
import re
import select
import shutil
import signal
import struct
import subprocess
import sys
import termios
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path

DEFAULT_URL = "http://127.0.0.1:8001"
DEFAULT_VOICE = "af_heart"
CONF_FILE = os.path.expanduser(
    os.environ.get("VOICE_TTS_CONF", "~/.config/voice-tts/config")
)
ENV_FILE = os.path.expanduser(
    os.environ.get("VOICE_TTS_ENV", "~/.config/pazras/voice-tts.env")
)
KNOWN_KEYS = {"url", "voice", "speed", "preroll"}
MAX_SENTENCE = 220  # characters; longer units are split at clause boundaries
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "voice-tts"
PREROLL_MS = 300  # silence in front of a cold first sentence; see wake_sink()
NOTIFY_EVERY_S = 30  # one notification per cause per this many seconds
HOLD_S = float(os.environ.get("VOICE_TTS_HOLD_S") or 30)  # an auto run held longer is dropped
NOTIFY_MAX = 300  # characters of a notification body
AHEAD = 3  # sentences synthesised ahead of the player; more is memory, not speed
STALL_S = 2.0  # a running player that takes no audio for this long has lost its sink
STALL_COLD_S = 8.0  # the same, before pw-cat has read anything: a Bluetooth link may still be waking
PIPE_BYTES = 16384  # player pipe: ~340 ms of audio, so a stall shows within one sentence
# Per-request limit on the service. A 200-220 character sentence took 3.1 to
# 7.5 s in the service's own log (2026-10-25..28, under load), and the first
# request may wait for the model to load. A restart is not a slow answer: the
# connection is refused or reset at once, so it ends the run within the budget
# anyway. Only a service that accepts and never answers waits this long.
SYNTH_TIMEOUT_S = float(os.environ.get("VOICE_TTS_SYNTH_TIMEOUT_S") or 30)

ABBREVIATIONS = {
    "e.g", "i.e", "vs", "etc", "cf", "al", "approx", "fig", "no", "dr", "mr",
    "mrs", "ms", "st", "jr", "sr", "inc", "ltd", "v", "p", "pp", "sec", "min",
}


# ------------------------------------------------------------------ failures


class Failure(Exception):
    """A run that could not speak. `cause` names the class a notification is
    rate-limited by: unreachable, token, service, sink, empty, input."""

    def __init__(self, cause: str, message: str):
        super().__init__(message)
        self.cause = cause
        self.message = message


def notify(cause: str, message: str, *, now: float | None = None,
           state: Path | None = None, extra=None) -> bool:
    """One desktop notification for a failure, unless this cause had one recently.

    The state file holds the time of the last notification per cause, so a key
    pressed five times at a dead service says so once. `now` and `state` are
    there for the tests: nothing has to sleep to cross the window. `extra` is a
    callable returning a line to append (the doctor's); it runs only when a
    notification is actually sent.
    """
    now = time.time() if now is None else now
    state = state or RUNTIME_DIR / "notified.state"   # not *.json: that is the registry
    try:
        seen = json.loads(state.read_text())
        if not isinstance(seen, dict):
            seen = {}
    except (OSError, ValueError):
        seen = {}
    last = seen.get(cause)
    if isinstance(last, (int, float)) and 0 <= now - last < NOTIFY_EVERY_S:
        return False
    seen[cause] = now
    try:
        state.parent.mkdir(parents=True, exist_ok=True)
        tmp = state.with_name(f".{state.name}.{os.getpid()}")
        tmp.write_text(json.dumps(seen))
        tmp.replace(state)
    except OSError:
        pass
    line = (message.splitlines() or [cause])[0][:200]
    tail = ""
    if extra is not None:
        try:
            tail = (extra() or "").strip()
        except Exception:  # noqa: BLE001 - the hint must never cost the notification
            tail = ""
    if tail:
        line = f"{line} \u2014 {tail}"[:NOTIFY_MAX]
    try:
        subprocess.run(["notify-send", "--app-name=say", "Speech failed", line],
                       capture_output=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return False
    return True


# ------------------------------------------------------------------ text shaping


def strip_unspoken(text: str) -> str:
    text = re.sub(r"```.*?```", "", text, flags=re.S)          # fenced code
    text = re.sub(r"`([^`]*)`", r"\1", text)                    # inline code
    text = re.sub(r"!\[[^\]]*\]\([^)]*\)", "", text)            # images
    text = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", text)        # links -> label
    text = re.sub(r"https?://\S+", "", text)                    # bare urls
    text = re.sub(r"^\s*\|.*$", "", text, flags=re.M)            # table rows (truncated too)
    text = re.sub(r"^.*\|.*\|.*$", "", text, flags=re.M)         # table rows
    text = re.sub(r"^\s*[-=]{3,}\s*$", "", text, flags=re.M)      # rules
    text = re.sub(r"^\s{0,3}#{1,6}\s*", "", text, flags=re.M)   # headings
    text = re.sub(r"^\s*[-*+]\s+", "", text, flags=re.M)        # bullets
    text = re.sub(r"^\s*\d+[.)]\s+", "", text, flags=re.M)      # numbered lists
    text = re.sub(r"[*_]{1,2}([^*_]+)[*_]{1,2}", r"\1", text)   # emphasis
    text = re.sub(r"[\u2014\u2013]", ", ", text)                 # em/en dash -> pause
    text = re.sub(r"[\u00b7\u2022\u25aa\u25ab\u2581-\u2588\u25cf\u25cb]", " ", text)
    text = re.sub(r"\s+", " ", text)
    return text.strip()


def split_sentences(text: str) -> list[str]:
    parts = re.split(r"(?<=[.!?])\s+", text)
    out: list[str] = []
    for part in parts:
        words = part.split()
        if not words:
            continue
        tail = words[-1].rstrip(".!?").lower()
        prev = out[-1] if out else None
        if tail in ABBREVIATIONS and prev is not None:
            out[-1] = f"{prev} {part}"          # glue abbreviations to the next sentence
            continue
        out.append(part)
    return [s for chunk in out for s in split_long(chunk)]


def split_long(sentence: str) -> list[str]:
    """Keep each request short enough that the first word arrives quickly."""
    if len(sentence) <= MAX_SENTENCE:
        return [sentence]
    pieces, current = [], ""
    for clause in re.split(r"(?<=[,;:])\s+", sentence):
        candidate = f"{current} {clause}".strip()
        if len(candidate) > MAX_SENTENCE and current:
            pieces.append(current)
            current = clause
        else:
            current = candidate
    if current:
        pieces.append(current)
    return pieces


# --------------------------------------------------------------------- service


def read_config() -> dict[str, str]:
    """`~/.config/voice-tts/config`, stowed from the dotfiles repo.

    key = value, blank lines and #comments ignored. Local to this machine on
    purpose: the token lives in ~/.config/pazras/, never here.
    """
    cfg: dict[str, str] = {}
    try:
        with open(CONF_FILE) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, val = line.split("=", 1)
                cfg[key.strip().lower()] = val.strip()
    except OSError:
        pass
    return cfg


def read_token(explicit: str | None) -> str:
    if explicit:
        return explicit
    if os.environ.get("VOICE_TTS_TOKEN"):
        return os.environ["VOICE_TTS_TOKEN"]
    try:
        with open(ENV_FILE) as fh:
            for line in fh:
                if line.startswith("VOICE_TTS_TOKEN="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return ""


# ---------------------------------------------------------------------- doctor


def _unit_state(unit: str) -> str:
    try:
        r = subprocess.run(["systemctl", "--user", "is-active", unit],
                           capture_output=True, text=True, timeout=5)
        return r.stdout.strip() or "unknown"
    except (OSError, subprocess.SubprocessError):
        return "unknown (no systemctl)"


def check_service(url: str, token: str) -> tuple[bool, str]:
    state = _unit_state("voice-tts")
    if state != "active":
        return False, f"unit voice-tts is {state}; systemctl --user start voice-tts"
    req = urllib.request.Request(
        f"{url.rstrip('/')}/health",
        headers={"Authorization": f"Bearer {token}"} if token else {},
    )
    try:
        with urllib.request.urlopen(req, timeout=3) as resp:
            body = json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as exc:
        return False, f"{url}/health answered {exc.code}"
    except (OSError, ValueError) as exc:
        return False, f"{url}/health gave no answer ({getattr(exc, 'reason', exc)})"
    if not body.get("ok"):
        return False, f"{url}/health answered but not ok"
    return True, f"unit active, {url}/health ok"


def check_token() -> tuple[bool, str]:
    via_env = bool(os.environ.get("VOICE_TTS_TOKEN"))
    try:
        mode = os.stat(ENV_FILE).st_mode & 0o777
    except OSError:
        if via_env:
            return True, f"{ENV_FILE} missing; token from VOICE_TTS_TOKEN"
        return False, f"{ENV_FILE} missing"
    if mode & 0o077:
        return False, f"{ENV_FILE} has mode {mode:o}; chmod 600 it"
    try:
        has_line = any(line.startswith("VOICE_TTS_TOKEN=") and line.split("=", 1)[1].strip()
                       for line in open(ENV_FILE))
    except OSError as exc:
        return False, f"cannot read {ENV_FILE} ({exc.strerror})"
    if not has_line:
        if via_env:
            return True, f"{ENV_FILE} has no token line; token from VOICE_TTS_TOKEN"
        return False, f"{ENV_FILE} has no VOICE_TTS_TOKEN= line"
    return True, f"{ENV_FILE} mode {mode:o}"


def check_sink() -> tuple[bool, str]:
    try:
        name = subprocess.run(["pactl", "get-default-sink"], capture_output=True,
                              text=True, timeout=5).stdout.strip()
        out = subprocess.run(["pactl", "-f", "json", "list", "sinks"],
                             capture_output=True, text=True, timeout=5).stdout
        sinks = json.loads(out)
    except (OSError, subprocess.SubprocessError, ValueError) as exc:
        return False, f"cannot query sinks with pactl ({exc})"
    if not name:
        return False, "no default sink; is PipeWire running?"
    for sink in sinks:
        if sink.get("name") == name:
            return True, f"{name} ({str(sink.get('state', '?')).upper()})"
    return False, f"default sink {name} is not among the sinks"


def check_tools() -> tuple[bool, str]:
    tools = ("pw-cat", "wl-paste", "notify-send")
    missing = [t for t in tools if not shutil.which(t)]
    if missing:
        return False, f"not on PATH: {', '.join(missing)}"
    return True, ", ".join(tools)


def check_watcher() -> tuple[bool, str]:
    state = _unit_state("voice-selection-watch")
    if state != "active":
        return False, f"unit voice-selection-watch is {state}"
    if not (RUNTIME_DIR.is_dir() and os.access(RUNTIME_DIR, os.W_OK | os.X_OK)):
        return False, f"stamp directory {RUNTIME_DIR} is missing or not writable"
    return True, f"unit active, {RUNTIME_DIR} writable"


def check_config() -> tuple[bool, str]:
    if not os.path.exists(CONF_FILE):
        return True, f"{CONF_FILE} not found; defaults apply"
    try:
        keys = read_config().keys()
        open(CONF_FILE).close()
    except OSError as exc:
        return True, f"{CONF_FILE} unreadable ({exc.strerror}); defaults apply"
    unknown = sorted(set(keys) - KNOWN_KEYS)
    if unknown:
        return False, f"unknown key in {CONF_FILE}: {', '.join(unknown)}"
    return True, f"{CONF_FILE}, keys known"


def doctor_line(cause: str, url: str, token: str) -> str:
    """The one doctor line for a failure's cause, or "" if no check matches."""
    if cause in ("unreachable", "service"):
        ok, detail = check_service(url, token)
        name = "service"
    elif cause == "token":
        ok, detail = check_token()
        name = "token"
    elif cause == "sink":
        ok, detail = check_sink()
        name = "sink"
    else:
        return ""
    return f"{'ok  ' if ok else 'FAIL'} {name}: {detail}"


def doctor(url: str, token: str) -> int:
    """Run the check classes in order; stop at the first class that fails.

    WHY. A dead key press says only that something is wrong. The chain has six
    links and the earlier ones explain the later ones (no unit, so no health;
    no token, so a 401), so the first failure is the one worth fixing. Nothing
    here speaks, wakes the sink, writes the registry or notifies.
    """
    checks = (("service", lambda: check_service(url, token)), ("token", check_token),
              ("sink", check_sink), ("tools", check_tools),
              ("watcher", check_watcher), ("config", check_config))
    for name, run in checks:
        ok, detail = run()
        print(f"{'ok  ' if ok else 'FAIL'} {name}: {detail}")
        if not ok:
            return 1
    return 0


def synth(text: str, *, url: str, token: str, voice: str, speed: float,
          timeout: float = SYNTH_TIMEOUT_S) -> bytes:
    body = json.dumps(
        {"input": text, "voice": voice, "speed": speed, "response_format": "pcm"}
    ).encode()
    req = urllib.request.Request(
        f"{url.rstrip('/')}/v1/audio/speech",
        data=body,
        headers={
            "Content-Type": "application/json",
            **({"Authorization": f"Bearer {token}"} if token else {}),
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read()
    except urllib.error.HTTPError as exc:
        if exc.code == 401:
            raise Failure("token", f"bad token for {url}; check ~/.config/pazras/voice-tts.env")
        detail = exc.read().decode("utf-8", "replace")[:200]
        raise Failure("service", f"{exc.code} from {url}: {detail}")
    except urllib.error.URLError as exc:
        raise Failure("unreachable", f"cannot reach {url} ({exc.reason}); is voice-tts running?")
    except OSError as exc:  # reset or timeout mid-reply: the service went away
        raise Failure("unreachable", f"lost {url} mid-reply ({exc}); is voice-tts running?")


def sink_suspended() -> bool:
    """True if the default sink is asleep, ignoring every failure.

    Bluetooth is the case that matters: after a few quiet seconds WirePlumber
    suspends the A2DP node, and the headset needs time to bring the transport
    back. Audio written before that finishes is played into nothing.
    """
    try:
        out = subprocess.run(["pactl", "-f", "json", "list", "sinks"],
                             capture_output=True, text=True, timeout=5).stdout
        name = subprocess.run(["pactl", "get-default-sink"], capture_output=True,
                              text=True, timeout=5).stdout.strip()
        for sink in json.loads(out):
            if sink.get("name") == name:
                return str(sink.get("state", "")).upper() == "SUSPENDED"
    except Exception:  # noqa: BLE001 - a missing pactl must not break speech
        pass
    return False


class SinkWake(threading.Thread):
    """Wake the sink while the first sentence is being synthesised.

    Started at the beginning of a run, so the three `pactl` calls (~0.3 s)
    overlap the service's ~0.5 s instead of preceding it — waking the device
    used to cost more than it saved. `cold` says whether it was asleep, which
    only the first write needs to know.
    """

    def __init__(self):
        super().__init__(daemon=True)
        self.cold = False
        self.ready = threading.Event()

    def run(self):
        try:
            self.cold = sink_suspended()
            subprocess.run(["pactl", "suspend-sink", "@DEFAULT_SINK@", "0"],
                           capture_output=True, timeout=5)
        except Exception:  # noqa: BLE001 - a missing pactl must not break speech
            pass
        finally:
            self.ready.set()

    def join_ready(self, timeout: float = 3.0) -> bool:
        self.ready.wait(timeout)
        return self.ready.is_set()


class Player:
    """One `pw-cat` for the whole run, so utterances join without a seam.

    A process per sentence would open a fresh PipeWire stream each time: an
    audible gap, another chance at a cold start, and — on Bluetooth — a device
    that may duck or renegotiate mid-reply.
    """

    def __init__(self, rate: int = 24000, preroll_ms: int = PREROLL_MS, cold: bool = False):
        self.rate = rate
        try:
            self.proc = subprocess.Popen(
                ["pw-cat", "--playback", "--raw", "--rate", str(rate), "--channels", "1",
                 "--format", "s16", "-"],
                stdin=subprocess.PIPE,
            )
        except OSError as exc:
            raise Failure("sink", f"cannot start pw-cat ({exc.strerror})")
        self.pipe = 65536
        try:
            self.pipe = fcntl.fcntl(self.proc.stdin.fileno(), fcntl.F_SETPIPE_SZ, PIPE_BYTES)
            os.set_blocking(self.proc.stdin.fileno(), False)
        except (OSError, AttributeError):
            pass    # a blocking pipe still works; only the stall watchdog is lost
        self.first = True
        self.written = 0
        self.heard = False  # pw-cat has read from the pipe at least once
        self.silence = b"\x00\x00" * int(rate * max(0, preroll_ms) / 1000) if cold else b""
        self.register()

    def _stalled(self, since: float | None, now: float) -> float | None:
        """The start of the current idle spell, or None while the player is paused.

        A stopped player (`say --pause`, state "T") takes no audio on purpose;
        the spell restarts when it is resumed, so a pause of any length is not
        a stall.
        """
        if _state(self.proc.pid) == "T":
            return None
        return now if since is None else since

    def _limit(self) -> float:
        """STALL_S once pw-cat has shown it reads; longer while the sink may be waking.

        pw-cat reads only once its stream runs, and a Bluetooth sink can take
        seconds to bring its link up. Bytes written minus bytes still in the
        pipe is what the player has taken.
        """
        if not self.heard:
            try:
                buf = fcntl.ioctl(self.proc.stdin.fileno(), termios.FIONREAD, b"\0" * 4)
                self.heard = self.written > struct.unpack("i", buf)[0]
            except (OSError, ValueError):
                self.heard = self.written > self.pipe
        return STALL_S if self.heard else STALL_COLD_S

    def write(self, pcm: bytes, abort=None) -> bool:
        """Feed the player; False if `abort()` ended the wait first.

        WHY. A blocking write into a pipe nobody reads never returns, and that
        is how a removed sink looks from here: `pw-cat` stays alive and stops
        reading. The pipe is small and non-blocking, so progress is visible: no
        byte accepted for STALL_S while the player is running means the sink is
        gone, and the player is killed.
        """
        data = memoryview(self.silence + pcm if self.first else pcm)
        self.first = False
        fd = self.proc.stdin.fileno()
        idle = None
        while data:
            if abort is not None and abort():
                return False
            try:
                _, ready, _ = select.select([], [fd], [], 0.1)
                if ready:
                    n = os.write(fd, data[:PIPE_BYTES])
                    data = data[n:]
                    self.written += n
                    idle = None
                    continue
            except BlockingIOError:
                pass
            except BrokenPipeError:
                # Not a stop: `say --stop` kills this process before its player.
                code = self.proc.wait()
                unregister()
                raise Failure("sink", f"playback failed: pw-cat exited with {code}; "
                                      "is a sink available?")
            now = time.monotonic()
            idle = self._stalled(idle, now)
            if idle is not None and now - idle >= self._limit():
                self.kill()
                raise Failure("sink", "playback stalled; is a sink available?")
        return True

    def kill(self):
        """End the player now and leave no registry entry."""
        try:
            self.proc.kill()
        except OSError:
            pass
        self.proc.wait()
        unregister()

    def close(self):
        self._limit()       # the pipe can be asked only while it is open
        try:
            self.proc.stdin.close()
        except OSError:
            pass
        idle = None
        while True:     # the tail drains in well under STALL_S unless the sink is gone
            try:
                code = self.proc.wait(timeout=0.1)
                break
            except subprocess.TimeoutExpired:
                now = time.monotonic()
                idle = self._stalled(idle, now)
                if idle is not None and now - idle >= self._limit():
                    self.kill()
                    raise Failure("sink", "playback stalled; is a sink available?")
        unregister()
        if code != 0:
            raise Failure("sink", f"playback failed: pw-cat exited with {code}; "
                                  "is a sink available?")

    # -- registry, so `say --stop` and the selection bind can interrupt it
    def register(self):
        TURN.update(player=self.proc.pid)


# ------------------------------------------------------------------ the arbiter


class Dropped(Exception):
    """An `auto` run held past HOLD_S by dictation. Not a failure: no notification."""


class Turn:
    """This run's registry entry, and the rule that decides when it may speak.

    WHY. One speaker at a time, in two lanes (decision 9 of dev/voice-out). A
    `user` run is a key press or a typed command: someone wants to hear this
    now, so it ends whatever is speaking and clears the `auto` queue. An `auto`
    run is a chat reply: it waits behind every earlier run, yields to the user,
    and holds while dictation records, because the microphone would hear it. A
    reply held longer than HOLD_S is dropped: spoken that late it answers a
    question nobody is still asking.

    The registry is one `<pid>.json` per run in RUNTIME_DIR, written from the
    start of the run, not from the first audio, so a waiting run can be seen and
    stopped. `arbiter.lock` serialises the decisions; an flock dies with its
    holder, so a killed run never leaves the lock taken. A stale entry is reaped
    by the executable-name guard (`_is_speech`), never by its age.
    """

    def __init__(self):
        self.entry: dict = {}

    @property
    def path(self) -> Path:
        return RUNTIME_DIR / f"{os.getpid()}.json"

    def update(self, **fields):
        if not self.entry:          # --out and --no-play never claim a turn
            return
        self.entry.update(fields)
        _write_entry(self.path, self.entry)

    def claim(self, lane: str):
        """Enter the registry: pre-empt (user) or join the queue (auto)."""
        with _arbiter_lock():
            if lane == "user":
                stop_all(locked=True)
                state = "playing"
            else:
                state = "waiting"
            self.entry = {"say": os.getpid(), "player": 0, "lane": lane,
                          "state": state, "seq": time.time_ns()}
            _write_entry(self.path, self.entry)

    def wait(self, *, poll: float = 0.1):
        """Block an auto run until it is its turn; raise Dropped past the hold limit."""
        if self.entry.get("state") == "playing":
            return
        held_since = None
        while True:
            with _arbiter_lock():
                ahead = [e for e in live_entries() if e.get("say") != os.getpid()
                         and (e.get("state", "playing") == "playing"
                              or (e.get("lane") == "auto"
                                  and e.get("seq", 0) < self.entry["seq"]))]
                if not ahead:
                    if not dictating():
                        self.update(state="playing")
                        return
                    held_since = held_since or time.monotonic()
                else:
                    held_since = None
            if held_since is not None and time.monotonic() - held_since >= HOLD_S:
                self.release()
                raise Dropped(f"dropped: dictation held this reply for {HOLD_S:g} s")
            time.sleep(poll)

    def release(self):
        self.entry = {}
        try:
            self.path.unlink()
        except OSError:
            pass


TURN = Turn()


def unregister():
    TURN.release()


def _write_entry(path: Path, entry: dict):
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_name(f".{path.name}.tmp")      # not *.json until complete
        tmp.write_text(json.dumps(entry))
        tmp.replace(path)
    except OSError:
        pass


class _arbiter_lock:
    def __enter__(self):
        try:
            RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
            self.fh = open(RUNTIME_DIR / "arbiter.lock", "a")
            fcntl.flock(self.fh, fcntl.LOCK_EX)
        except OSError:
            self.fh = None          # no lock is a race, not a reason to stay silent
        return self

    def __exit__(self, *exc):
        if self.fh is not None:
            self.fh.close()


def dictating() -> bool:
    """True while voxtype records. A missing voxtype is never recording."""
    try:
        out = subprocess.run(["voxtype", "status"], capture_output=True, text=True,
                             timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return out.strip().lower().startswith("recording")


def _pids(entry: dict) -> list[int]:
    pids = []
    for key in ("say", "player"):
        try:
            pid = int(entry.get(key) or 0)
        except (TypeError, ValueError):
            pid = 0
        if pid:
            pids.append(pid)
    return pids


def live_entries() -> list[dict]:
    """Every registry entry whose `say` is still speech; the rest are reaped."""
    out = []
    try:
        files = list(RUNTIME_DIR.glob("*.json"))
    except OSError:
        return out
    for f in files:
        try:
            entry = json.loads(f.read_text())
            if not isinstance(entry, dict):
                raise ValueError
        except (OSError, ValueError):
            f.unlink(missing_ok=True)
            continue
        if not any(_is_speech(pid) for pid in _pids(entry)):
            f.unlink(missing_ok=True)
            continue
        out.append(entry)
    return out


def _state(pid: int) -> str:
    """Single-letter process state from /proc, or "" if it is gone."""
    try:
        return Path(f"/proc/{pid}/stat").read_text().split(") ", 1)[1][0]
    except (OSError, IndexError):
        return ""


def signal_players(sig: int, *, only_state: str | None = None) -> int:
    """Send `sig` to every live player in the registry, in either lane."""
    acted = 0
    for entry in live_entries():
        pid = int(entry.get("player") or 0)
        if not pid or not _is_speech(pid):
            continue
        if only_state is not None and _state(pid) != only_state:
            continue
        try:
            os.kill(pid, sig)
            acted += 1
        except OSError:
            pass
    return acted


def pause_or_resume() -> int:
    """SIGSTOP a running player, or SIGCONT a stopped one — one key, two jobs."""
    if signal_players(signal.SIGSTOP, only_state="S"):
        return 0
    if signal_players(signal.SIGCONT, only_state="T"):
        return 0
    return 1


def stop_all(*, locked: bool = False) -> int:
    """End every run in both lanes, waiting ones too. Returns how many were speaking.

    A run that only waited is removed but not counted, so the selection key's
    "stop if speaking, else speak" still speaks when the queue held a reply.
    """
    if not locked:
        with _arbiter_lock():
            return stop_all(locked=True)
    speaking = 0
    for entry in live_entries():
        pids = [p for p in _pids(entry) if p != os.getpid()]
        if not pids:
            continue
        if entry.get("state", "playing") == "playing":
            speaking += 1
        for pid in pids:  # a stopped process holds SIGTERM until it is resumed
            if _is_speech(pid) and _state(pid) == "T":
                try:
                    os.kill(pid, signal.SIGCONT)
                except OSError:
                    pass
        for sig in (15, 9):
            for pid in pids:
                if not _is_speech(pid):
                    continue
                try:
                    os.kill(pid, sig)
                except OSError:
                    pass
            time.sleep(0.15)
            if not any(_alive(pid) for pid in pids):
                break
        (RUNTIME_DIR / f"{entry.get('say')}.json").unlink(missing_ok=True)
    return speaking


def _alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _is_speech(pid: int) -> bool:
    """Alive *and* demonstrably ours.

    A pid in a stale registry file can be reused by an unrelated process, so
    only the executable counts: `pw-cat`, or a script named `say`. Matching the
    whole command line would kill any process that merely mentions the name.
    """
    if not _alive(pid):
        return False
    try:
        argv = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\x00")
    except OSError:
        return False
    names = [os.path.basename(a.decode("utf-8", "replace")) for a in argv[:2] if a]
    return any(n in ("pw-cat", "say") for n in names)


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description="Speak text through local voice-tts")
    ap.add_argument("text", nargs="*", help="text to speak; reads stdin if empty")
    ap.add_argument("-f", "--file", help="read this file instead of stdin")
    ap.add_argument("-c", "--clipboard", action="store_true", help="speak the clipboard")
    ap.add_argument("--voice", help=f"kokoro voice id (default: config, else {DEFAULT_VOICE})")
    ap.add_argument("--speed", type=float, help="1.0 = as recorded; 1.2 = 20%% faster")
    ap.add_argument("--url", help=f"service base url (default: config, else {DEFAULT_URL})")
    ap.add_argument("--voices", action="store_true", help="list available voices and exit")
    ap.add_argument("--token")
    ap.add_argument("--out", help="write a single concatenated WAV here instead of playing")
    ap.add_argument("--no-play", action="store_true", help="synthesise only, write nothing")
    ap.add_argument("--raw", action="store_true", help="read the text verbatim, no cleaning")
    ap.add_argument("--preroll", type=int, metavar="MS",
                    help="silence sent ahead of a cold first sentence (default %d)" % PREROLL_MS)
    ap.add_argument("--stop", action="store_true",
                    help="stop a run that is speaking, then exit (status 1 if silent)")
    ap.add_argument("--pause", action="store_true", help="freeze playback where it is")
    ap.add_argument("--resume", action="store_true", help="continue a paused run")
    ap.add_argument("--toggle-pause", action="store_true",
                    help="pause if speaking, resume if paused (status 1 if neither)")
    ap.add_argument("--lane", choices=("user", "auto"), default="user",
                    help="user (default) pre-empts any speech; auto waits its turn, "
                         "yields to user runs and holds while dictation records")
    ap.add_argument("--notify", action="store_true",
                    help="also report a failure as a desktop notification (for key binds)")
    ap.add_argument("--doctor", action="store_true",
                    help="check the service, token, sink, tools, watcher and config; exit 1 on the first failure")
    ap.add_argument("--verbose", "-v", action="store_true", help="print per-sentence timing")
    args = ap.parse_args(argv)

    if args.stop:
        return 0 if stop_all() else 1
    if args.pause:
        return 0 if signal_players(signal.SIGSTOP, only_state="S") else 1
    if args.resume:
        return 0 if signal_players(signal.SIGCONT, only_state="T") else 1
    if args.toggle_pause:
        return pause_or_resume()

    cfg = read_config()
    voice = args.voice or os.environ.get("VOICE_TTS_VOICE") or cfg.get("voice") or DEFAULT_VOICE
    speed = args.speed
    if speed is None:
        speed = float(os.environ.get("VOICE_TTS_SPEED") or cfg.get("speed", 1.0))
    url = args.url or os.environ.get("VOICE_TTS_URL") or cfg.get("url") or DEFAULT_URL
    token = read_token(args.token)

    if args.doctor:
        return doctor(url, token)

    if args.voices:
        req = urllib.request.Request(
            f"{url.rstrip('/')}/v1/audio/voices",
            headers={"Authorization": f"Bearer {token}"} if token else {},
        )
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read())
        print(" ".join(data["voices"]))
        print(f"default: {data['default']}", file=sys.stderr)
        return 0

    try:
        return speak(args, cfg=cfg, voice=voice, speed=speed, url=url, token=token)
    except Dropped as exc:
        print(f"say: {exc}", file=sys.stderr)
        return 3
    except Failure as exc:
        print(f"say: {exc.message}", file=sys.stderr)
        if args.notify:
            notify(exc.cause, exc.message,
                   extra=lambda: doctor_line(exc.cause, url, token))
        return 2 if exc.cause == "empty" else 1
    except Exception as exc:  # a bug, not a cause: still never silent at a key
        if args.notify:
            notify("error", f"{type(exc).__name__}: {exc}")
        raise
    finally:
        TURN.release()


def speak(args, *, cfg: dict[str, str], voice: str, speed: float, url: str,
          token: str) -> int:
    """Read the input, then synthesise and play it sentence by sentence."""
    if args.text:
        raw = " ".join(args.text)
    elif args.clipboard:
        try:
            raw = subprocess.run(["wl-paste", "--no-newline"], capture_output=True,
                                 text=True, timeout=5).stdout
        except (OSError, subprocess.SubprocessError) as exc:
            raise Failure("input", f"cannot read the clipboard ({exc})")
    elif args.file:
        try:
            raw = Path(args.file).read_text(encoding="utf-8", errors="replace")
        except OSError as exc:
            raise Failure("input", f"cannot read {args.file} ({exc.strerror})")
    else:
        raw = sys.stdin.read()
    text = raw if args.raw else strip_unspoken(raw)
    if not text:
        raise Failure("empty", "nothing to speak: the input has no speakable text")

    sentences = split_sentences(text)

    chunks: queue.Queue = queue.Queue(maxsize=AHEAD)
    done = threading.Event()
    stop = threading.Event()
    failure: list[BaseException] = []

    def producer():
        try:
            for i, sentence in enumerate(sentences):
                if stop.is_set():
                    return
                t0 = time.perf_counter()
                pcm = synth(sentence, url=url, token=token, voice=voice, speed=speed)
                item = (i, sentence, pcm, time.perf_counter() - t0)
                while not stop.is_set():    # the consumer may be gone: never wait forever
                    try:
                        chunks.put(item, timeout=0.1)
                        break
                    except queue.Full:
                        pass
        except BaseException as exc:  # noqa: BLE001 - surfaced in the consumer
            failure.append(exc)
        finally:
            done.set()

    playing = not args.out and not args.no_play
    preroll = args.preroll if args.preroll is not None else int(cfg.get("preroll", PREROLL_MS))
    wake = None
    if playing:
        TURN.claim(args.lane)
        if TURN.entry["state"] == "playing":    # the user lane: wake the sink now
            wake = SinkWake()
            wake.start()
    cold = False
    player = None

    threading.Thread(target=producer, daemon=True).start()

    collected: list[bytes] = []
    first_audio_at = None
    t_start = time.perf_counter()

    # A fault ends the run now. A dead service means the sentences still queued
    # are not worth playing out: the player is killed, then the cause is raised.
    try:
        while True:
            if failure:
                break
            try:
                i, sentence, pcm, took = chunks.get(timeout=0.1)
            except queue.Empty:
                if done.is_set():
                    break
                continue
            if args.verbose:
                print(f"[{i + 1}/{len(sentences)}] {took * 1000:.0f} ms · {len(pcm) // 48} ms "
                      f"audio · {sentence[:60]!r}", file=sys.stderr)
            if first_audio_at is None:
                first_audio_at = time.perf_counter() - t_start
            if args.out:
                collected.append(pcm)
            elif playing:
                if player is None:
                    if wake is None:        # an auto run: its turn first, then the sink
                        TURN.wait()
                        wake = SinkWake()
                        wake.start()
                    cold = wake.cold if wake.join_ready() else True
                    if args.verbose and cold:
                        print(f"sink was asleep: {preroll} ms of lead-in silence", file=sys.stderr)
                    player = Player(rate=24000, preroll_ms=preroll, cold=cold)
                player.write(pcm, abort=lambda: bool(failure))

        if failure:
            if player is not None:
                player.kill()
            raise failure[0]
        if player is not None:
            player.close()
    except BaseException:
        if player is not None and player.proc.poll() is None:
            player.kill()
        raise
    finally:
        stop.set()

    if args.out:
        write_wav(args.out, b"".join(collected))
        print(f"say: wrote {args.out}", file=sys.stderr)
    if args.verbose and first_audio_at is not None:
        print(f"first audio after {first_audio_at * 1000:.0f} ms", file=sys.stderr)
    return 0


def write_wav(path: str, pcm: bytes, rate: int = 24000):
    import wave

    with wave.open(path, "wb") as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(rate)
        wf.writeframes(pcm)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
