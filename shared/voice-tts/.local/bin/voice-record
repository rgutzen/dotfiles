#!/usr/bin/env bash
# voice-record -- start dictation, and stop any speech already in the room.
#
# Bound to SUPER+SHIFT+L (was `voxtype record toggle`). Two reasons the stop
# comes first: the microphone would otherwise record the voice it is meant to
# replace, and dictation is the moment the operator has decided to talk, so the
# machine should be quiet.
set -uo pipefail

#
# `say --stop` exits 1 when nothing was speaking, which is not a failure. A
# failed toggle is: the key has no terminal, so its cause becomes a notification.

say --stop >/dev/null 2>&1 || true
if ! out="$(voxtype record toggle 2>&1)"; then
    notify-send --app-name=voice-record "Dictation failed" \
        "$(printf '%s' "${out:-voxtype record toggle failed}" | head -n 1)" 2>/dev/null || true
    exit 1
fi
[[ -n $out ]] && printf '%s\n' "$out"
exit 0
