[Unit]
Description=voice-tts selection recency — when the primary selection and the clipboard last changed
Documentation=file:%h/.local/bin/voice-selection-watch
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/voice-selection-watch
Restart=always
RestartSec=2
# Idle almost always; whatever it does must never compete with the session.
Nice=10

[Install]
WantedBy=graphical-session.target
