[Unit]
Description=The model chart's weekly scout — nominate a model the chart moved, for the reader calibration to measure

[Timer]
OnCalendar=Mon *-*-* 07:30:00
Persistent=true
RandomizedDelaySec=20m

[Install]
WantedBy=timers.target
