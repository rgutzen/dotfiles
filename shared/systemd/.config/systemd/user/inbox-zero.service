[Unit]
Description=Inbox Zero (self-hosted AI email assistant) — Docker Compose stack
Documentation=https://docs.getinboxzero.com/self-hosting
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/.inbox-zero
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop

[Install]
WantedBy=default.target
