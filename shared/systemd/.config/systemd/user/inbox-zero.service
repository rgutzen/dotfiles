[Unit]
Description=Inbox Zero (self-hosted AI email assistant) — Docker Compose stack
Documentation=https://docs.getinboxzero.com/self-hosting
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/.inbox-zero
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The pull is best-effort: at boot DNS may not be up yet, and a failed pull must not fail
# the unit when the images are already local. `--pull missing` overrides the compose
# file's `pull_policy: always`, so `up` never touches the network for a cached image.
ExecStartPre=-/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d --pull missing
# At shutdown the docker daemon may already be gone; the containers stop with it.
ExecStop=-/usr/bin/docker compose stop

[Install]
WantedBy=default.target
