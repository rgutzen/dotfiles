[Unit]
Description=Reconcile remote restic copies with the local repo
OnFailure=pazras-notify@%n.service
[Service]
Type=oneshot
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# DRY RUN on the timer, deliberately. Deleting backup data is never automatic:
# the scheduled run reports what is eligible; you apply it with
#   pazras-system backup reconcile --execute
ExecStart=%h/06_SYSTEM/scripts/pazras-system backup reconcile
Nice=19
IOSchedulingClass=idle
