[Unit]
Description=Open a Claude window on purpose — a 5-minute tick that pings Haiku when the last 5h window has ended (state-driven, no interval)

[Timer]
OnCalendar=*:0/5
AccuracySec=1s

[Install]
WantedBy=timers.target
