# GENERATED by timers-gen.sh — do not hand-edit.
# Edit PAZRAS_TIMERS in config/structure/pazras-master-config.sh, then run:
#   familiar schedule timers            (stage into 06_SYSTEM/config/schedule)
#   familiar schedule timers --check    (diff staged vs. live, no writes)
# Applying a staged change to this live file is a human sign-off, not a
# mechanical step — see timers-gen.sh header.

[Unit]
Description=Daily health check — drift, live state, last unit results (no network, no model)

[Timer]
OnCalendar=*-*-* 06:45:00
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
