[Unit]
Description=The evaluation layer's weekly read — one batch of readings per measured component, no verdict

[Timer]
OnCalendar=Mon *-*-* 08:00:00
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
