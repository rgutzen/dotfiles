#!/usr/bin/env bash
# Run Pi under a billing profile. Installed as symlinks named pi-<profile>
# (pi-teres -> pi-profile); the profile is the part of the name after "pi-".
#
#   pi-<profile> login     sign in once to that profile's Claude account; words
#                          after it go to `claude auth login`, so `pi-teres login
#                          --sso` or `--email me@work.example` work
#   pi-<profile> status    show which Claude account the profile resolves to
#   pi-<profile> [args]    pi under the profile, args passed through
#
# A profile changes three things for the whole Pi process:
#   - Claude: the subscription account. If Omarchy knows an account whose id is
#     the profile name (omarchy agent account add claude Teres), Pi uses that
#     account's config home, so Claude history, settings and skills are the one
#     shared set Omarchy maintains. Otherwise the profile keeps a private login
#     in ~/.claude-<profile>.
#   - API keys: only this profile's own <KEY>_<PROFILE> variables stay; every
#     other *_API_KEY / *_API_TOKEN / *_ACCESS_TOKEN is unset, so no personal
#     provider ID reaches /model, whether or not a company twin exists.
#   - Nothing else gets in: an exported ANTHROPIC_* credential or base URL, or
#     CLAUDE_CODE_OAUTH_TOKEN, outranks the login the profile just chose.
#   - PI_PROFILE: the provider-aliases extension moves the session's model to
#     the <provider>-<profile> alias.
#
# Overflow. 06_SYSTEM's profiles.yaml may give a profile an ordered `overflow:`
# list of other profiles, and a profile a `keys:` profile whose <KEY>_<PROFILE>
# keys it shares (a second Claude seat of the same account holder). Before pi
# starts, `familiar orchestration profile pick` names the first profile in the
# chain whose Claude window has room; when that is another one, this execs
# pi-<that profile>. The account stays bound for the whole process, so a window
# that runs out mid-session takes a restart (`pi-<profile> -c` continues the
# session on the next account). Without 06_SYSTEM a profile runs alone.
#
# The directory decides which profile runs (see 40-ai.sh: a .pi-profile file
# names it). That deliberately overrides Omarchy's machine-wide active account:
# the nearest profile wins, and omarchy agent account use stays for everything
# launched outside a marked directory.
#
# New profile: omit the Omarchy account, export <KEY>_<PROFILE> keys in
# ~/.config/bash/local.sh, then
#   ln -s pi-profile ~/02_AREAS/B_Tech/dotfiles/shared/bin/.local/bin/pi-<profile>
# A subscription provider (Claude) needs no key at all: sign it in with
# `pi-<profile> login`.
set -euo pipefail

profile="$(basename "$0")"
profile="${profile#pi-}"
if [[ "$profile" == profile || -z "$profile" ]]; then
    echo "pi-profile: call through a pi-<profile> symlink, e.g. pi-teres" >&2
    exit 2
fi
export PI_PROFILE="$profile"

# The config home of the Omarchy account named like this profile. Prints
# nothing when Omarchy has no registry, no claude entry, or no such account.
omarchy_claude_home() {
    command -v omarchy >/dev/null 2>&1 || return 1
    command -v jq >/dev/null 2>&1 || return 1
    local json
    json=$(timeout 5 omarchy agent account list 2>/dev/null) || return 1
    jq -er --arg id "$profile" '
        (if type == "array" then .[] else . end)
        | select(.provider == "claude")
        | .accounts[]
        | select((.id | ascii_downcase) == ($id | ascii_downcase))
        | .home' <<<"$json"
}

# Claude keeps ~/.claude.json beside the default home and $DIR/.claude.json
# inside any other, so the primary account must stay implicit: pointing the
# variable at ~/.claude would make Claude look for a login that is not there.
if omarchy_home=$(omarchy_claude_home); then
    claude_source="omarchy account $profile"
    if [[ "$omarchy_home" == "$HOME/.claude" ]]; then
        unset CLAUDE_CONFIG_DIR
    else
        export CLAUDE_CONFIG_DIR="$omarchy_home"
    fi
else
    claude_source="profile home"
    export CLAUDE_CONFIG_DIR="$HOME/.claude-$profile"
fi
claude_home="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

# Exported Anthropic auth outranks the Claude login the profile just picked: an
# API key bills the API, ANTHROPIC_BASE_URL bills a gateway, and claude-code's own
# OAuth token skips the config dir. Any of them makes the profile name a lie, so
# say it instead of running quietly against the wrong account.
for override in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL CLAUDE_CODE_OAUTH_TOKEN; do
    if [[ -n "${!override:-}" ]]; then
        echo "pi-$profile: $override is exported and overrides the $profile Claude login" >&2
    fi
done

case "${1:-}" in
    login)
        if [[ "$claude_source" == omarchy* ]]; then
            echo "pi-$profile: ${profile^} is an Omarchy account, so its login is Omarchy's." >&2
            echo "pi-$profile: add or repair it with: omarchy agent account add claude ${profile^}" >&2
        fi
        exec claude auth login "${@:2}"
        ;;
    status)
        printf 'profile      %s\n' "$profile"
        printf 'claude home  %s%s\n' "$claude_home" \
            "$([[ -n "${CLAUDE_CONFIG_DIR:-}" ]] || echo " (implicit)")"
        printf 'claude from  %s\n' "$claude_source"
        exec claude auth status
        ;;
esac

# The overflow hand-over, and whose API keys this profile spends (see the top).
# PI_PROFILE_PINNED marks a launch that was already handed over, so it never loops.
keys="$profile"
if command -v familiar >/dev/null 2>&1; then
    pin=()
    [[ -n "${PI_PROFILE_PINNED:-}" ]] && pin=(--pinned)
    if picked=$(timeout 20 familiar orchestration profile pick "$profile" "${pin[@]}" 2>/dev/null); then
        { read -r run; read -r keys; read -r why; } <<<"$picked" || true
        if [[ -n "$run" && "$run" != "$profile" ]] && command -v "pi-$run" >/dev/null 2>&1; then
            echo "pi-$profile: $why; running as pi-$run" >&2
            PI_PROFILE_PINNED=1 exec "pi-$run" "$@"
        fi
        [[ -n "$why" ]] && echo "pi-$profile: $why" >&2
        keys="${keys:-$profile}"
    fi
fi
unset PI_PROFILE_PINNED
if [[ "$keys" != "$profile" ]]; then
    export PI_PROFILE_KEYS="$keys"
else
    unset PI_PROFILE_KEYS
fi
suffix="_${keys^^}"

while IFS= read -r name; do
    unset "${name%"$suffix"}"
done < <(compgen -e | grep -- "$suffix\$" || true)

# Deny by default (06_SYSTEM dev/privacy 4i): the loop above drops a personal key
# only when the profile has its own twin, so revoking a company key EXPOSED the
# personal one (DEEPSEEK_API_KEY under pi-teres, 2026-11-13). Every other
# credential-shaped variable that is not one of this profile's own <KEY>_<PROFILE>
# leaves the environment too. Names only; no value is read.
while IFS= read -r name; do
    [[ "$name" == *"$suffix" ]] && continue
    unset "$name"
done < <(compgen -e | grep -E -- '^[A-Z0-9_]+_(API_KEY|API_TOKEN|ACCESS_TOKEN)(_[A-Z0-9]+)?$' || true)

if [[ ! -f "$claude_home/.credentials.json" ]]; then
    echo "pi-$profile: no Claude login in $claude_home — Claude models unavailable" >&2
    if [[ "$claude_source" == omarchy* ]]; then
        echo "pi-$profile: sign ${profile^} in with: omarchy agent account add claude ${profile^}" >&2
    else
        echo "pi-$profile: sign in with: pi-$profile login" >&2
    fi
fi

exec pi "$@"
