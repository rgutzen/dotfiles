#!/usr/bin/env bash
# Connect to the NYU VPN, clearing stale resolver state first.
#
# Default: openconnect + openconnect-sso (embedded Qt login window). Since
# 2026-10-27 the Cisco client's external-browser SSO hangs after login, and its
# embedded login needs webkit2gtk-4.0, which Arch no longer ships.
# `nyu-vpn --cisco` still launches the Cisco client.
#
# AnyConnect writes NYU's nameservers into systemd-resolved's global (ifindex 0)
# scope and does not revert them when a tunnel dies uncleanly. With the tunnel
# gone those servers are unreachable, so the next connect cannot resolve
# vpn.nyu.edu and fails with "unsuccessful domain name resolution". The state is
# runtime-only and owned by resolved, so nothing short of restarting resolved
# clears it -- restarting NetworkManager does not.
set -euo pipefail

# Only NYU's servers (128.122.x) count as stale: resolved.conf sets its own
# global DNS, so a non-empty Global scope alone is the normal state.
global_dns() { resolvectl dns | sed -n '/^Global:/,/^[^ ]/p' | grep -o '128\.122\.[0-9.]*' | tr '\n' ' '; }

if ip link show cscotun0 &>/dev/null || ip link show tun0 &>/dev/null; then
    echo "nyu-vpn: tunnel is already up"
    exit 0
fi

if [[ -n "$(global_dns)" ]]; then
    echo "nyu-vpn: stale global resolver state ($(global_dns)), restarting systemd-resolved"
    sudo systemctl restart systemd-resolved
fi

if ! getent hosts vpn.nyu.edu >/dev/null; then
    echo "nyu-vpn: vpn.nyu.edu still does not resolve" >&2
    exit 1
fi

if [[ ${1:-} == --cisco ]]; then
    shift
    exec /opt/cisco/anyconnect/bin/vpnui "$@"
fi

for cmd in openconnect openconnect-sso; do
    command -v "$cmd" >/dev/null || { echo "nyu-vpn: $cmd not installed" >&2; exit 1; }
done
# DTLS (UDP) drops inbound packets here (EMSGSIZE): TCP connects, but no data
# returns. TLS-only carries all traffic. Further arguments go to openconnect.
exec openconnect-sso --server vpn.nyu.edu --user rg5022@nyu.edu -- --no-dtls "$@"
